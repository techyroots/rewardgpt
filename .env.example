# ---- Database -------------------------------------------------------------
# SQLite locally; switch provider to "postgresql" in prisma/schema.prisma for
# production and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Privy (wallet connect + auth) ---------------------------------------
# From https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ---- Verification ---------------------------------------------------------
# "mock" runs the local simulator; "reclaim" runs real zkTLS proofs.
VERIFIER_MODE="mock"

# From https://dev.reclaimprotocol.org — one provider id per service.
RECLAIM_APP_ID=""
RECLAIM_APP_SECRET=""
RECLAIM_PROVIDER_CHATGPT=""
RECLAIM_PROVIDER_CLAUDE=""
RECLAIM_PROVIDER_GROK=""

# ---- Privacy --------------------------------------------------------------
# Keys the nullifier HMAC. Rotating it lets every subscription claim again,
# so treat it as permanent. Generate with: openssl rand -hex 32
NULLIFIER_PEPPER=""

# ---- Treasury / payouts ---------------------------------------------------
# The single wallet all cashback is paid from. Keep it out of version control;
# use a secrets manager in production.
TREASURY_PRIVATE_KEY=""
# "base" or "base-sepolia"
CHAIN="base-sepolia"
NEXT_PUBLIC_CHAIN="base-sepolia"
RPC_URL=""

# ---- Limits ---------------------------------------------------------------
DAILY_PAYOUT_CAP_USD="500"
CLAIM_COOLDOWN_DAYS="30"
PROOF_MAX_AGE_MINUTES="10"
