# ---- Database -------------------------------------------------------------
# Postgres, locally and in production. A free Neon or Vercel Postgres database
# is enough. Use the pooled connection string on serverless hosts.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Privy (wallet connect + auth) ---------------------------------------
# From https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ---- Verification ---------------------------------------------------------
# "mock" runs the local simulator; "reclaim" runs real zkTLS proofs.
VERIFIER_MODE="mock"

# From https://dev.reclaimprotocol.org — one provider id per service.
RECLAIM_APP_ID=""
RECLAIM_APP_SECRET=""
RECLAIM_PROVIDER_CHATGPT=""
RECLAIM_PROVIDER_CLAUDE=""
RECLAIM_PROVIDER_GROK=""

# ---- Privacy --------------------------------------------------------------
# Keys the nullifier HMAC. Rotating it lets every subscription claim again,
# so treat it as permanent. Generate with: openssl rand -hex 32
NULLIFIER_PEPPER=""

# ---- Treasury / payouts (Solana) -----------------------------------------
# The single wallet all cashback is paid from, as a base58 secret key (what
# Phantom exports) or the JSON byte array the Solana CLI writes. Keep it out of
# version control; use a secrets manager in production.
TREASURY_SECRET_KEY=""
# "devnet" while testing, "mainnet-beta" in production.
SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Optional: pin the SOL/USD rate instead of fetching it. Testing only — in
# production this would freeze the conversion and stop cashback being 5%.
# SOL_USD_PRICE=""

# ---- Limits ---------------------------------------------------------------
DAILY_PAYOUT_CAP_USD="500"
CLAIM_COOLDOWN_DAYS="30"
PROOF_MAX_AGE_MINUTES="10"
